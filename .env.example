# ===============================================
# BankOS Backend - Plantilla de Variables de Entorno (NestJS)
# ===============================================

PORT=3000
NODE_ENV=development

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bankos_db
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bankos_db

# Redis & Colas (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Identidad y Autenticación (Keycloak OIDC)
KEYCLOAK_ISSUER=http://localhost:8080/realms/bankos
KEYCLOAK_AUDIENCE=bankos-api

# Opcional: JWT Secret de contingencia / fallback
JWT_SECRET=super_secret_jwt_key_bankos_local
JWT_EXPIRATION=3600s
